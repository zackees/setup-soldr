FROM rust:1.95.0-trixie

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential \
       ca-certificates \
       cmake \
       curl \
       libssl-dev \
       ninja-build \
       pkg-config \
       python3 \
       python3-venv \
       zstd \
    && rm -rf /var/lib/apt/lists/*

ARG SOLDR_VERSION=0.9.3
RUN python3 -m venv /opt/soldr \
    && /opt/soldr/bin/pip install --disable-pip-version-check "soldr==${SOLDR_VERSION}" \
    && /opt/soldr/bin/soldr --version

ENV PATH="/opt/soldr/bin:${PATH}" \
    CARGO_BUILD_JOBS=2 \
    SOLDR_JOBS=2
WORKDIR /workspace
